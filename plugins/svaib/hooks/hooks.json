{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/inject_space_map.py\" first-prompt",
            "timeout": 15,
            "statusMessage": "Карта пространства — в начале разговора"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/usage_log.py\" prompt",
            "timeout": 10,
            "statusMessage": "Учёт работы скиллов — новый запрос"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__whoami",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/inject_space_map.py\" post-whoami",
            "timeout": 15,
            "statusMessage": "Карта вашей зоны — после входа в svaib"
          }
        ]
      },
      {
        "matcher": "mcp__.*__update_me",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/inject_space_map.py\" post-update-me",
            "timeout": 15,
            "statusMessage": "Ваши настройки и путь освоения — после изменения"
          }
        ]
      },
      {
        "matcher": "Read|Glob|Grep|Bash|mcp__workspace__bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/inject_space_map.py\" node-enter",
            "timeout": 15,
            "statusMessage": "Карта папки — при первом обращении к ней"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/inject_space_map.py\" compact",
            "timeout": 15,
            "statusMessage": "Карта пространства — после сжатия разговора"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/inject_file_spec.py\" compact",
            "timeout": 10,
            "statusMessage": "Требования к файлам — после сжатия разговора (Claude Code)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/check_deferred_actions.py\"",
            "timeout": 15,
            "statusMessage": "Проверка обещаний «сделаю потом» — конец ответа"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/usage_log.py\" stop",
            "timeout": 10,
            "statusMessage": "Учёт работы скиллов — конец ответа"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|apply_patch|Bash|exec_command|shell|local_shell|unified_exec|mcp__workspace__bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/inject_file_spec.py\" pre-write",
            "timeout": 10,
            "statusMessage": "Требования к файлу — перед первой записью"
          }
        ]
      },
      {
        "matcher": "Skill|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/usage_log.py\" skill",
            "timeout": 10,
            "statusMessage": "Учёт работы скиллов — запуск скилла или субагента"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/inject_file_spec.py\" compact",
            "timeout": 10,
            "statusMessage": "Требования к файлам — после сжатия разговора (Codex)"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/usage_log.py\" end",
            "timeout": 10,
            "statusMessage": "Учёт работы скиллов — конец сессии"
          }
        ]
      }
    ]
  }
}
